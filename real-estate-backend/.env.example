# VELMORA Real Estate - Backend Environment Configuration

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# JWT Authentication Secret Key (Required: Replace with a secure random secret in production)
JWT_SECRET=replace_with_a_random_secret

# CORS Allowed Origins (Comma-separated list, e.g. http://localhost:3000 in dev, https://velmora.in in production)
CORS_ORIGIN=http://localhost:3000

# Database Configuration
# Leave DATABASE_URL empty for local development to use SQLite (DB_STORAGE)
# For Render / Production deployment: Provide PostgreSQL connection string in DATABASE_URL
# Example: postgresql://username:password@hostname:5432/velmora_db
DATABASE_URL=
DB_STORAGE=database.sqlite

