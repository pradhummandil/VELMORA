# VELMORA Real Estate - Backend Environment Configuration

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# JWT Authentication Secret Key (MUST be rotated in production)
JWT_SECRET=velmora_luxury_realestate_jwt_secret_change_in_production

# CORS Allowed Origins (Comma-separated list or * for development)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://velmora.in

# Database Configuration
# Leave DATABASE_URL empty to use default local SQLite storage (database.sqlite)
# For PostgreSQL in production: postgresql://username:password@hostname:5432/velmora_db
DATABASE_URL=
